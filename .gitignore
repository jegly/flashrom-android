# Native build workspace.
# native/ holds the build scripts, the libusb patch and the meson cross file,
# which are all tracked. work/ is upstream clones (each with its own .git),
# sysroot/ is the staging install tree and out/ is build output. The finished
# libraries are committed under app/src/main/jniLibs/ instead.
/native/work/
/native/sysroot/
/native/out/

