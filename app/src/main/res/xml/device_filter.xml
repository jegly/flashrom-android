<?xml version="1.0" encoding="utf-8"?>

<!--
    Dedicated programmers only. This list decides which devices make Android
    offer to launch the app on plug-in (USB_DEVICE_ATTACHED); it does NOT limit
    what the app can use: UsbManager.getDeviceList() and requestPermission()
    still see any device via "Detect and connect".

    Generic serial adapters (CP210x, PL2303, CH340, CH9102,
    Arduino/Teensy/Pico/mbed/ST-CDC) were removed because they made the app
    offer itself every time any serial cable was plugged in.
-->
<resources>
    <!-- 0x0403 / 0x60??: FTDI (ft2232_spi and similar) -->
    <usb-device
        vendor-id="1027"
        product-id="24577" /> <!-- 0x6001: FT232R -->
    <usb-device
        vendor-id="1027"
        product-id="24592" /> <!-- 0x6010: FT2232H -->
    <usb-device
        vendor-id="1027"
        product-id="24593" /> <!-- 0x6011: FT4232H -->
    <usb-device
        vendor-id="1027"
        product-id="24596" /> <!-- 0x6014: FT232H -->
    <usb-device
        vendor-id="1027"
        product-id="24597" /> <!-- 0x6015: FT230X, FT231X, FT234XD -->

    <!-- 0x1a86: Qinheng CH341A / CH347 -->
